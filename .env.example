# Copy this file to backend/.env and fill in the values you want to enable.
# Every value is optional - the app works with none of them configured,
# it just shows the relevant channel as "Not Configured".

SECRET_KEY=change-this-to-a-random-string

# --- Telegram Bot (optional) ---
# 1. Create a bot with @BotFather on Telegram to get a token.
# 2. Each user pastes their own numeric Telegram chat id into their profile
#    (they can get it by messaging @userinfobot).
TELEGRAM_BOT_TOKEN=

# --- SMS via Twilio (optional) ---
# Create a free trial account at https://www.twilio.com to get these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+10000000000

# --- Email via SMTP (optional) ---
# Works with any SMTP provider. For Gmail: host smtp.gmail.com, port 587,
# security tls, username your Gmail address, password a 16-character
# "App Password" from https://myaccount.google.com/apppasswords (not your
# normal Gmail password — Google blocks that for this).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Automated voice call via Twilio Voice (optional) ---
TWILIO_CALL_FROM=+10000000000
# PUBLIC_BASE_URL = the address your phone/Twilio can reach this app on
# (e.g. http://192.168.1.20:5000 on the same Wi-Fi, or an ngrok URL). It is used
# for the "Taken / Not Taken" links in Email and SMS reminders. Leave blank to
# use http://127.0.0.1:5000 (links then only work on the same computer).
PUBLIC_BASE_URL=

# --- Follow-ups / phone numbers (optional) ---
# Re-send an unanswered reminder every N minutes (set in Settings, default 5)
# up to this many times before the dose is marked Missed.
MAX_FOLLOWUPS=6
# Added to phone numbers typed without a country code (Twilio needs +91...).
DEFAULT_COUNTRY_CODE=+91

# Windows only, if Tesseract is not in C:\Program Files\Tesseract-OCR
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
